[Unit]
Description=Userspace Tailscale for OpenClaw through SSH proxy
After=openclaw-tailnet-proxy.service
Requires=openclaw-tailnet-proxy.service

[Service]
Type=simple
Environment=HTTPS_PROXY=socks5://127.0.0.1:11080
Environment=HTTP_PROXY=socks5://127.0.0.1:11080
Environment=ALL_PROXY=socks5://127.0.0.1:11080
ExecStart=/usr/sbin/tailscaled --tun=userspace-networking --state=%h/.local/share/tailscale-openclaw/tailscaled.state --statedir=%h/.local/share/tailscale-openclaw --socket=%t/tailscale-openclaw/tailscaled.sock --socks5-server=127.0.0.1:11055 --outbound-http-proxy-listen=127.0.0.1:11056 --port=0 --no-logs-no-support
Restart=on-failure
RestartSec=5
RuntimeDirectory=tailscale-openclaw
RuntimeDirectoryMode=0700

[Install]
WantedBy=default.target
